# Copy to .env.local and fill in. Never commit .env.local.
# With no PayPal credentials the app runs a clearly labelled *simulated* PayPal
# so the whole flow can be exercised locally. Sandbox only: live is refused.

# --- PayPal: merchant sandbox app (app 1) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# --- PayPal: agent operator sandbox app (app 2, Payouts enabled) ---
PAYPAL_OPERATOR_CLIENT_ID=
PAYPAL_OPERATOR_CLIENT_SECRET=

# Merchant sandbox account email (receives the bond payout on agent fault)
PAYPAL_MERCHANT_EMAIL=

# Webhook created for <host>/api/webhooks/paypal
PAYPAL_WEBHOOK_ID=

# Optional: "sandbox" or "mock". Default: sandbox when credentials are set, else mock.
PAYPAL_MODE=

# --- Gemini (Google AI Studio, free tier) ---
GOOGLE_GENERATIVE_AI_API_KEY=
# Any Flash model shown as free in AI Studio
GEMINI_MODEL=gemini-2.5-flash

# --- Optional ---
# Arbiter confidence below this goes to MANUAL_REVIEW (0..1)
ARBITER_CONFIDENCE_THRESHOLD=0.7
# Set to 1 to keep the SQLite file across restarts (default: reset on boot)
SENTINEL_KEEP_DB=
